# Copy to .env and fill in the section for the compute you use.

# Default compute when --compute is not passed: aws | local | slurm
COMPUTE=aws

# Seqera Platform live monitoring (cloud.seqera.io > avatar > Your tokens).
# When set, scripts/run.sh adds -with-tower. AWS head jobs read the token from Secrets
# Manager (methyl-flow/tower-access-token), so set it there too. Leave empty to run without it.
TOWER_ACCESS_TOKEN=

# Local (Docker). Match Docker Desktop's VM CPU and memory, not the Mac's.
LOCAL_MAX_CPUS=8
LOCAL_MAX_MEMORY="16 GB"

# Slurm (Apptainer)
SLURM_QUEUE=
SLURM_ACCOUNT=
SLURM_MAX_CPUS=32
SLURM_MAX_MEMORY="256 GB"
SLURM_MAX_TIME="72 h"
# APPTAINER_CACHEDIR=/path/to/shared/apptainer-cache

# AWS Batch (values from the MethylFlowBatchStack outputs, see infra/aws/README.md)
# Credentials come from your AWS profile or SSO session, never this file.
# AWS_PROFILE=my-profile
AWS_REGION=us-east-1
BATCH_QUEUE=
AWS_S3_WORKDIR=s3://your-bucket/work
AWS_S3_OUTDIR=s3://your-bucket/results
AWS_HEAD_QUEUE=methyl-flow-ondemand
AWS_HEAD_JOB_DEFINITION=methyl-flow-nextflow-head
AWS_S3_RUNDIR=s3://your-bucket/runs
BATCH_CLI_PATH=/home/ec2-user/miniconda/bin/aws
AWS_MAX_CPUS=64
AWS_MAX_MEMORY="256 GB"
