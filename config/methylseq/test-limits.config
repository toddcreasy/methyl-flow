/*
 * Loaded by scripts/run_methylseq.sh after compute.config for test runs on slurm or aws.
 * The compute profiles' resourceLimits override the pipeline's test profile
 * (a -c file always loads after the pipeline config, whatever the -profile
 * order), which makes tiny test tasks request full-size resources.
 */

process.resourceLimits = [
    cpus  : 4,
    memory: '15 GB',
    time  : '1 h'
]
