/*
 * Compute environments for every pipeline launched from this repo (scripts/run.sh).
 * Pick one with -profile (local | slurm | aws). Site values come from .env.
 */

profiles {

    local {
        process.executor = 'local'
        docker.enabled   = true
        // Pipeline images are amd64-only; run them under emulation on Apple Silicon (no-op on x86_64)
        docker.runOptions = '-u $(id -u):$(id -g) --platform=linux/amd64'
        // resourceLimits caps each task; these cap the sum of concurrent tasks (Docker Desktop VM size)
        executor.cpus    = (env('LOCAL_MAX_CPUS') ?: '8').toInteger()
        executor.memory  = env('LOCAL_MAX_MEMORY') ?: '16 GB'
        process.resourceLimits = [
            cpus  : (env('LOCAL_MAX_CPUS') ?: '8').toInteger(),
            memory: (env('LOCAL_MAX_MEMORY') ?: '16 GB'),
            time  : '24 h'
        ]
    }

    slurm {
        process.executor       = 'slurm'
        process.queue          = env('SLURM_QUEUE')
        process.clusterOptions = env('SLURM_ACCOUNT') ? "--account=${env('SLURM_ACCOUNT')}" : null
        executor.queueSize         = 50
        executor.submitRateLimit   = '10 sec'
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        apptainer.cacheDir     = env('APPTAINER_CACHEDIR')
        process.resourceLimits = [
            cpus  : (env('SLURM_MAX_CPUS') ?: '32').toInteger(),
            memory: (env('SLURM_MAX_MEMORY') ?: '256 GB'),
            time  : (env('SLURM_MAX_TIME') ?: '72 h')
        ]
    }

    aws {
        workDir           = env('AWS_S3_WORKDIR')
        aws.region        = env('AWS_REGION') ?: 'us-east-1'
        aws.batch.cliPath = env('BATCH_CLI_PATH') ?: '/home/ec2-user/miniconda/bin/aws'
        aws.batch.maxParallelTransfers = 8
        // Resubmit jobs whose Spot instance is reclaimed (default 0 since Nextflow 24.10)
        aws.batch.maxSpotAttempts = 3
        executor.queueSize = 100

        // Keep every process setting in this one block: a separate process { } block in a
        // profile replaces earlier process.* lines instead of merging with them.
        process {
            executor = 'awsbatch'
            // Not AWS_BATCH_*: Batch reserves that prefix and drops such variables from a head job
            queue    = env('BATCH_QUEUE')
            resourceLimits = [
                cpus  : (env('AWS_MAX_CPUS') ?: '64').toInteger(),
                memory: (env('AWS_MAX_MEMORY') ?: '256 GB'),
                time  : '72 h'
            ]

            // nf-core defaults (process_high: 12 CPUs, 72 GB) are sized for full-depth data.
            // At 5 million reads per sample these steps use a fraction of that, and Batch
            // reserves the full request, so few tasks fit at once. The index build keeps its default.
            withName: '.*:FASTQC' {
                cpus   = 2
                memory = 4.GB
            }
            withName: '.*:TRIMGALORE' {
                cpus   = 4
                memory = 8.GB
            }
            withName: '.*:GUNZIP' {
                cpus   = 1
                memory = 2.GB
            }
            withName: '.*:BISMARK_ALIGN' {
                cpus   = 8
                memory = 32.GB
            }
        }
    }
}
