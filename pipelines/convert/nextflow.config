manifest {
    name            = 'methyl-flow/convert'
    description     = 'Convert Bismark coverage files into the methyl-floor beta table and sample sheet'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.04.0'
}

process {
    // python 3.14 + pyarrow 26.0.0 (PyPI, same as uv.lock), built by Seqera Containers
    container = 'community.wave.seqera.io/library/python_pip_pyarrow:980f173daf8c5efb'
    shell     = ['/bin/bash', '-euo', 'pipefail']

    withName: 'CONVERT' {
        cpus   = 4
        memory = 16.GB
    }
}

// Interactive execution report and timeline, plus a trace table, for every run (as nf-core does)
// Declared here so the blocks below can read it; scripts/run.sh sets it with --outdir
params.outdir = null
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
}
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
}
