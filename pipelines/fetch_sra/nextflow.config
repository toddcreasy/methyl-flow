manifest {
    name            = 'methyl-flow/fetch_sra'
    description     = 'Fetch full-quality SRA runs, downsample with seqtk, fetch the reference'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.04.0'
}

process {
    // sra-tools 3.2.1 + seqtk 1.4 (bioconda), built by Seqera Containers
    container     = 'community.wave.seqera.io/library/sra-tools_seqtk:67fdf6e5e7fd06bc'
    shell         = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = 'retry'
    maxRetries    = 2

    withName: 'FETCH_AND_SAMPLE' {
        cpus   = 8
        memory = 16.GB
        // Each task holds about 25 GB on disk (.sra plus unpacked FASTQ); limit how many
        // share an instance's 200 GB root volume.
        maxForks = 6
    }
    withName: 'FETCH_REFERENCE' {
        cpus   = 1
        memory = 2.GB
    }
}

// Interactive execution report and timeline, plus a trace table, for every run (as nf-core does)
// Declared here so the blocks below can read it; scripts/run.sh sets it with --outdir
params.outdir = null
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
}
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
}
