manifest {
    name            = 'methyl-flow/qc'
    description     = 'QC summary table and plots for a methylseq run and its beta table'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.04.0'
}

process {
    // python 3.14 + pyarrow 26.0.0, numpy 2.5.4, matplotlib 3.11.2 (PyPI, same as uv.lock),
    // built by Seqera Containers
    container = 'community.wave.seqera.io/library/python_pip_pyarrow_numpy_matplotlib:6b986572f0cd3f13'
    shell     = ['/bin/bash', '-euo', 'pipefail']

    withName: 'QC_TABLE' {
        cpus   = 2
        memory = 8.GB
    }
    withName: 'QC_PLOTS' {
        cpus   = 2
        memory = 8.GB
    }
}
