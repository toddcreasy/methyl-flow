manifest {
    name            = 'methyl-flow/dss'
    description     = 'Differential methylation, tumor against matched normal, with DSS'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.04.0'
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']

    withName: 'DSS_TEST' {
        // R 4.5.2 + DSS 2.58.0 + data.table 1.17.8 (Bioconda), from BioContainers
        container = 'quay.io/biocontainers/bioconductor-dss:2.58.0--r45h01b2380_0'
        cpus      = 4
        memory    = 32.GB
    }
    withName: 'ANNOTATE|DSS_REPORT' {
        // Same image as pipelines/qc: python 3.14 + pyarrow, numpy, matplotlib
        container = 'community.wave.seqera.io/library/python_pip_pyarrow_numpy_matplotlib:6b986572f0cd3f13'
        cpus      = 2
        memory    = 8.GB
    }
}

// Declared here so the blocks below can read it; scripts/run.sh sets it with --outdir
params.outdir = null
// Interactive execution report and timeline, plus a trace table, for every run (as nf-core does)
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
}
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
}
